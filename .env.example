# Admin bootstrap (first user gets these if DB empty)
FLASHBACK_ADMIN_EMAIL=admin@localhost
FLASHBACK_ADMIN_PASSWORD=ChangeMe123!
FLASHBACK_ADMIN_NAME=Flashback Owner

# Session
SESSION_COOKIE=fb_session
# 7 days in seconds
SESSION_TTL_SEC=604800

# Security (set to 'true' only behind HTTPS/ngrok)
SECURE_COOKIES=false

# Server
HOST=127.0.0.1
PORT=8010